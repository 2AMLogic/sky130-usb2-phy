{
  "netlist": "diff-tt-nominal.spice",
  "engine": "ngspice",
  "backend": "batch",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/ngspice/sky130.lib.spice"
  },
  "corners": {
    "process": [
      "tt_mm"
    ],
    "supply_v": {
      "vsup": [
        3.3
      ]
    },
    "temperature_c": [
      27.0
    ]
  },
  "monte_carlo": {
    "n": 400,
    "seed": 166,
    "vary": "mismatch"
  },
  "analysis": {
    "kind": "dc",
    "args": "vd -0.4 0.4 0.001"
  },
  "measurements": [
    {
      "name": "vth_cm0p80_v",
      "spice": ".meas dc vth_cm0p80_v WHEN v(rxd08)=v(half) CROSS=1"
    },
    {
      "name": "rxd_p200_cm0p80_v",
      "spice": ".meas dc rxd_p200_cm0p80_v FIND v(rxd08) AT=0.2"
    },
    {
      "name": "rxd_m200_cm0p80_v",
      "spice": ".meas dc rxd_m200_cm0p80_v FIND v(rxd08) AT=-0.2"
    },
    {
      "name": "vth_cm1p65_v",
      "spice": ".meas dc vth_cm1p65_v WHEN v(rxd165)=v(half) CROSS=1"
    },
    {
      "name": "rxd_p200_cm1p65_v",
      "spice": ".meas dc rxd_p200_cm1p65_v FIND v(rxd165) AT=0.2"
    },
    {
      "name": "rxd_m200_cm1p65_v",
      "spice": ".meas dc rxd_m200_cm1p65_v FIND v(rxd165) AT=-0.2"
    },
    {
      "name": "vth_cm2p50_v",
      "spice": ".meas dc vth_cm2p50_v WHEN v(rxd25)=v(half) CROSS=1"
    },
    {
      "name": "rxd_p200_cm2p50_v",
      "spice": ".meas dc rxd_p200_cm2p50_v FIND v(rxd25) AT=0.2"
    },
    {
      "name": "rxd_m200_cm2p50_v",
      "spice": ".meas dc rxd_m200_cm2p50_v FIND v(rxd25) AT=-0.2"
    }
  ],
  "options": {
    "timeout_s": 900,
    "stage_model_inputs": true
  },
  "remote": {
    "hosts": 4
  },
  "batch": {
    "capacity_wait_s": 900,
    "max_concurrent_jobs": 2
  }
}
