{
  "netlist": "body.spice",
  "engine": "ngspice",
  "backend": "batch",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/ngspice/sky130.lib.spice"
  },
  "corners": {
    "process": [
      "tt",
      "ff",
      "ss",
      "fs",
      "sf"
    ],
    "supply_v": {
      "vsup": [
        3.0,
        3.3,
        3.6
      ]
    },
    "temperature_c": [
      -40.0,
      27.0,
      100.0
    ]
  },
  "analysis": {
    "kind": "dc",
    "args": "vdum 0 1 1"
  },
  "measurements": [
    {
      "name": "voh_v",
      "spice": ".meas dc voh_v FIND v(voh) AT=0"
    },
    {
      "name": "vol_v",
      "spice": ".meas dc vol_v FIND v(vol) AT=0"
    },
    {
      "name": "vm_v",
      "spice": ".meas dc vm_v FIND v(vm) AT=0"
    },
    {
      "name": "isup_ua",
      "spice": ".meas dc isup_ua FIND i(vsup) AT=0"
    }
  ],
  "options": {
    "timeout_s": 300,
    "keep_artifacts": true
  },
  "batch": {
    "runner_version_check": "warn"
  }
}
