{
  "netlist": "body.spice",
  "engine": "ngspice",
  "backend": "batch",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/ngspice/sky130.lib.spice"
  },
  "corners": {
    "process": [
      "tt",
      "ff",
      "ss",
      "fs",
      "sf"
    ],
    "supply_v": {
      "vsup": [
        3.0,
        3.3,
        3.6
      ]
    },
    "temperature_c": [
      -40.0,
      27.0,
      100.0
    ]
  },
  "analysis": {
    "kind": "dc",
    "args": "vdum 0 1 1"
  },
  "measurements": [
    {
      "name": "vdp_c00_v",
      "spice": ".meas dc vdp_c00_v FIND v(dp00) AT=0"
    },
    {
