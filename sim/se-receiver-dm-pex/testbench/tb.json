{
  "netlist": "se_rx_dm_pex_tb.spice",
  "engine": "ngspice",
  "backend": "batch",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/ngspice/sky130.lib.spice"
  },
  "corners": {
    "units": [
      {
        "process": "tt",
        "temperature_c": 27,
        "supply_v": {
          "vsup": 3.3
        }
      },
      {
        "process": "ff_lh",
        "temperature_c": 100,
        "supply_v": {
          "vsup": 3.0
        }
      }
    ]
  },
  "analysis": {
    "kind": "dc",
    "args": "vin 0 3.0 0.001"
  },
  "measurements": [
    {
      "name": "vth_v",
      "spice": ".meas dc vth_v WHEN v(rxdm)=v(half) RISE=1",
      "unit": "V",
      "limits": {
        "min": 0.8,
        "max": 2.0
      }
    },
    {
      "name": "vth_last_v",
      "spice": ".meas dc vth_last_v WHEN v(rxdm)=v(half) CROSS=LAST",
      "unit": "V",
      "limits": {
        "min": 0.8,
        "max": 2.0
      }
    },
    {
      "name": "rxd_low_max_v",
      "spice": ".meas dc rxd_low_max_v MAX v(rxdm) FROM=0 TO=0.8",
      "unit": "V"
    },
    {
      "name": "rxd_high_min_v",
      "spice": ".meas dc rxd_high_min_v MIN v(rxdm) FROM=2.0 TO=3.0",
      "unit": "V"
    },
    {
      "name": "rxd_at_vil_v",
      "spice": ".meas dc rxd_at_vil_v FIND v(rxdm) AT=0.8",
      "unit": "V"
    },
    {
      "name": "rxd_at_vih_v",
      "spice": ".meas dc rxd_at_vih_v FIND v(rxdm) AT=2.0",
      "unit": "V"
    },
    {
      "name": "isup_ua",
      "spice": ".meas dc isup_ua FIND i(vi) AT=1.4",
      "unit": "A",
      "limits": {
        "min": 1e-06,
        "max": 0.0005
      }
    }
  ],
  "options": {
    "timeout_s": 900,
    "keep_artifacts": true
  }
}
